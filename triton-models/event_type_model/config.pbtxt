
name: "event_type_model"
platform: "onnxruntime_onnx"
max_batch_size: 0
version_policy { latest { num_versions: 1 } }
input [
  {
    name: "input"
    data_type: TYPE_FP32
    dims: [-1, 5000]
  }
]

output [
  {
    name: "label"
    data_type: TYPE_INT64
    dims: [-1]
  }
]

output [
  {
    name: "probabilities"
    data_type: TYPE_FP32
    dims: [-1, 9]
  }
]
